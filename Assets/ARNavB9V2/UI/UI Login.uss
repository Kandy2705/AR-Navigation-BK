@import url("unity-theme://default");


.screen-root {
  flex-grow: 1;
  position: relative;
}

.login-root {
  flex-grow: 1;
}

.login-loading {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  display: none;
  justify-content: center;
  align-items: center;
  z-index: 999;
}

.loading-dim {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;

  background-color: rgba(25, 25, 25, 0.57);
  opacity: 0;

  transition-property: opacity;
  transition-duration: 180ms;
  transition-timing-function: ease-out;
}


.login-loading.is-on .loading-dim {
  opacity: 1;
}

.loading-card {
  position: relative;

  padding: 28px 16px;
  border-radius: 14px;

  background-color: rgba(25, 25, 25, 1);

  border-width: 1px;
  border-color: rgba(25, 25, 25, 1);

  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);

  z-index: 1000;
}


.loading-text {
  color: rgba(255, 255, 255, 0.92);
  font-size: 16px;
  font-weight: 500;
  text-align: center;
}
