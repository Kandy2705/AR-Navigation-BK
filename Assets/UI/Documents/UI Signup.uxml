<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/UI%20Login.uss?fileID=7433441132597879392&amp;guid=67e30c38130c706428a8dd8094df7dd6&amp;type=3#UI Login" />
    <ui:VisualElement name="ScreenRoot" style="flex-grow: 1;">
        <ui:VisualElement name="SignupRoot" style="flex-direction: column; flex-grow: 1; background-color: rgb(25, 25, 25); padding-left: 16px; padding-right: 16px; margin-top: 0; padding-top: 20px; display: flex;">
            <ui:VisualElement name="Header" style="height: 44px; align-items: flex-start; justify-content: flex-start; margin-top: 0; margin-bottom: 16px;">
                <ui:Button name="SignUpBackButton" text="←" style="width: 40px; height: 40px; background-color: transparent; color: white; font-size: 20px; padding: 0; margin-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; left: -2px;" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: column; flex-grow: 1; margin-top: 0;">
                <ui:Label name="Title" text="Hoàn thiện hồ sơ của bạn!" style="color: rgb(243, 243, 243); font-size: 28px; font-weight: 800; margin-top: 0; -unity-font-style: bold; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-bottom: 12px; margin-left: 0; margin-right: 0; white-space: normal;" />
                <ui:Label name="Subtitle" text="Để được tham gia thì bạn hãy hoàn thiện hồ sơ bên dưới." style="color: rgb(196, 196, 196); font-size: 13px; margin-top: 4px; width: 100%; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-bottom: 4px; margin-right: 0; margin-left: 0; flex-wrap: wrap; flex-direction: column; white-space: pre-wrap;" />
                <ui:VisualElement name="InputUserName" style="margin-top: 32px; background-color: rgb(25, 25, 25); border-radius: 12px; padding: 12px; width: 100%; border-left-color: rgb(37, 37, 37); border-right-color: rgb(37, 37, 37); border-top-color: rgb(37, 37, 37); border-bottom-color: rgb(37, 37, 37); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 0; border-left-width: 1px; padding-top: 0; padding-right: 16px; padding-bottom: 0; padding-left: 16px; border-bottom-right-radius: 0; border-bottom-left-radius: 0;">
                    <ui:VisualElement name="InputUserName" style="position: relative; flex-direction: row; align-items: center;">
                        <ui:TextField name="UserNameField" placeholder="Email" placeholder-text="Tên người dùng" style="flex-grow: 1; color: rgb(255, 255, 255); background-color: rgba(0, 0, 0, 0); border: none; padding-right: 0; align-content: auto; align-self: center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; -unity-background-image-tint-color: rgba(255, 255, 255, 0.72); font-size: 16px; background-size: 100% 100%; height: 54px; -unity-text-outline-color: rgba(255, 255, 255, 0); padding-top: 0; padding-bottom: 0; padding-left: 0;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="InputPhoneNumber" style="margin-top: 0; background-color: rgb(25, 25, 25); border-radius: 12px; padding: 12px; width: 100%; border-left-color: rgb(37, 37, 37); border-right-color: rgb(37, 37, 37); border-top-color: rgb(37, 37, 37); border-bottom-color: rgb(37, 37, 37); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 0; border-left-width: 1px; padding-top: 0; padding-right: 16px; padding-bottom: 0; padding-left: 16px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0;">
                    <ui:VisualElement name="PhoneNumber" style="position: relative; flex-direction: row; align-items: center;">
                        <ui:TextField name="PhoneNumberField" placeholder="Mật khẩu" isPassword="true" password="false" placeholder-text="Số điện thoại" style="flex-grow: 1; color: rgb(255, 255, 255); background-color: transparent; border: none; padding-right: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; -unity-text-align: upper-left; align-content: auto; align-self: center; justify-content: flex-start; font-size: 16px; height: 54px; -unity-text-outline-color: rgba(255, 255, 255, 0); padding-top: 0; padding-bottom: 0; padding-left: 0;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="InputEmail" style="margin-top: 0; background-color: rgb(25, 25, 25); border-radius: 12px; padding: 12px; width: 100%; border-left-color: rgb(37, 37, 37); border-right-color: rgb(37, 37, 37); border-top-color: rgb(37, 37, 37); border-bottom-color: rgb(37, 37, 37); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 0; border-left-width: 1px; padding-top: 0; padding-right: 16px; padding-bottom: 0; padding-left: 16px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0;">
                    <ui:VisualElement name="Email" style="position: relative; flex-direction: row; align-items: center;">
                        <ui:TextField name="EmailField" placeholder="Mật khẩu" isPassword="true" password="false" placeholder-text="Email" style="flex-grow: 1; color: rgb(255, 255, 255); background-color: transparent; border: none; padding-right: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; -unity-text-align: upper-left; align-content: auto; align-self: center; justify-content: flex-start; font-size: 16px; height: 54px; -unity-text-outline-color: rgba(255, 255, 255, 0); padding-top: 0; padding-bottom: 0; padding-left: 0;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="InputGender" style="margin-top: 0; background-color: rgb(25, 25, 25); border-radius: 12px; padding: 12px; width: 100%; border-left-color: rgb(37, 37, 37); border-right-color: rgb(37, 37, 37); border-top-color: rgb(37, 37, 37); border-bottom-color: rgb(37, 37, 37); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 0; border-left-width: 1px; padding-top: 0; padding-right: 16px; padding-bottom: 0; padding-left: 16px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0;">
                    <ui:VisualElement name="InputGender" style="position: relative; flex-direction: row; align-items: center;">
                        <ui:TextField name="GenderField" placeholder="Mật khẩu" isPassword="true" password="false" placeholder-text="Giới tính" style="flex-grow: 1; color: rgb(255, 255, 255); background-color: transparent; border: none; padding-right: 36px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; -unity-text-align: upper-left; align-content: auto; align-self: center; justify-content: flex-start; font-size: 16px; height: 54px; -unity-text-outline-color: rgba(255, 255, 255, 0);" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="InputBirth" style="margin-top: 0; background-color: rgb(25, 25, 25); border-radius: 12px; padding: 12px; width: 100%; border-left-color: rgb(37, 37, 37); border-right-color: rgb(37, 37, 37); border-top-color: rgb(37, 37, 37); border-bottom-color: rgb(37, 37, 37); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; padding-top: 0; padding-right: 16px; padding-bottom: 0; padding-left: 16px; border-top-left-radius: 0; border-top-right-radius: 0;">
                    <ui:VisualElement name="InputBirth" style="position: relative; flex-direction: row; align-items: center;">
                        <ui:TextField name="InputBirthField" placeholder="Mật khẩu" isPassword="true" password="false" placeholder-text="Ngày sinh" style="flex-grow: 1; color: rgb(255, 255, 255); background-color: transparent; border: none; padding-right: 36px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; -unity-text-align: upper-left; align-content: auto; align-self: center; justify-content: flex-start; font-size: 16px; height: 54px; -unity-text-outline-color: rgba(255, 255, 255, 0);" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="NextSignUpButton" text="Tiếp tục&#10;" style="height: 52px; width: 100%; background-color: rgb(59, 49, 137); color: rgb(243, 243, 243); border-radius: 28px; margin-bottom: 32px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; margin-top: 0; margin-right: 0; margin-left: 0; padding-top: 12px; padding-bottom: 12px; padding-right: 16px; padding-left: 16px; font-size: 16px;" />
        </ui:VisualElement>
        <ui:VisualElement name="ForgotPasswordRoot" style="flex-direction: column; flex-grow: 1; background-color: rgb(25, 25, 25); padding-left: 16px; padding-right: 16px; margin-top: 0; padding-top: 20px; display: none;">
            <ui:VisualElement name="Header" style="height: 44px; align-items: flex-start; justify-content: flex-start; margin-top: 0; margin-bottom: 16px;">
                <ui:Button name="OtpBackButton" text="←" style="width: 40px; height: 40px; background-color: transparent; color: white; font-size: 20px; padding: 0; margin-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; left: -2px;" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: column; flex-grow: 1; margin-top: 0;">
                <ui:Label name="Title" text="Nhập mã OTP" style="color: rgb(243, 243, 243); font-size: 28px; font-weight: 800; margin-top: 0; -unity-font-style: bold; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-bottom: 12px; margin-left: 0; margin-right: 0;" />
                <ui:Label name="Subtitle" text="Chúng tôi đã gửi mã OTP đến email của bạn là *****ley@yourdomoincom. Nhập mã OTP bên dưới để xác minh." style="color: rgb(196, 196, 196); font-size: 13px; margin-top: 4px; width: 100%; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-bottom: 4px; margin-right: 0; margin-left: 0; flex-wrap: wrap; flex-direction: column; white-space: pre-wrap;" />
                <ui:VisualElement name="NumberOTP" style="flex-grow: 1; align-self: auto; flex-direction: row; justify-content: space-between; height: auto; margin-top: 60px;">
                    <ui:IntegerField value="0" max-length="1" name="Otp1" style="width: 73.75px; height: 70px; max-width: 73.75px; -unity-background-image-tint-color: rgb(20, 20, 20); background-image: none; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; -unity-text-align: middle-center; font-size: 28px; -unity-font-style: bold; text-overflow: clip; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; border-bottom-left-radius: 12px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(37, 37, 37); border-right-color: rgb(37, 37, 37); border-top-color: rgb(37, 37, 37); border-bottom-color: rgb(37, 37, 37); color: rgb(186, 186, 186);" />
                    <ui:IntegerField value="0" max-length="1" name="Otp2" style="width: 73.75px; height: 70px; max-width: 73.75px; -unity-background-image-tint-color: rgb(20, 20, 20); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; -unity-text-align: middle-center; font-size: 28px; -unity-font-style: bold; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; border-bottom-left-radius: 12px; color: rgb(186, 186, 186);" />
                    <ui:IntegerField value="0" max-length="1" name="Otp3" style="width: 73.75px; height: 70px; max-width: 73.75px; -unity-background-image-tint-color: rgb(20, 20, 20); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; -unity-text-align: middle-center; font-size: 28px; -unity-font-style: bold; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; border-bottom-left-radius: 12px; color: rgb(186, 186, 186);" />
                    <ui:IntegerField value="0" max-length="1" name="Otp4" style="width: 73.75px; height: 70px; max-width: 73.75px; -unity-background-image-tint-color: rgb(20, 20, 20); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; -unity-text-align: middle-center; font-size: 28px; -unity-font-style: bold; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; border-bottom-left-radius: 12px; color: rgb(186, 186, 186);" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="OtpConfirmButton" text="Xác nhận" style="height: 52px; width: 100%; background-color: rgb(59, 49, 137); color: rgb(243, 243, 243); border-radius: 28px; margin-bottom: 32px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; margin-top: 0; margin-right: 0; margin-left: 0; padding-top: 12px; padding-bottom: 12px; padding-right: 16px; padding-left: 16px; font-size: 16px;" />
        </ui:VisualElement>
        <ui:VisualElement name="PasswordNewRoot" style="flex-direction: column; flex-grow: 1; background-color: rgb(25, 25, 25); padding-left: 16px; padding-right: 16px; margin-top: 0; padding-top: 20px; display: none;">
            <ui:VisualElement name="Header" style="height: 44px; align-items: flex-start; justify-content: flex-start; margin-top: 0; margin-bottom: 16px;">
                <ui:Button name="NewPassBackButton" text="←" style="width: 40px; height: 40px; background-color: transparent; color: white; font-size: 20px; padding: 0; margin-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; left: -2px;" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: column; flex-grow: 1; margin-top: 0;">
                <ui:Label name="Title" text="Tuyệt vời gần xong rồi, Đặt mật khẩu nào!" style="color: rgb(243, 243, 243); font-size: 28px; font-weight: 800; margin-top: 0; -unity-font-style: bold; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-bottom: 12px; margin-left: 0; margin-right: 0; flex-wrap: nowrap; white-space: normal;" />
                <ui:Label name="Subtitle" text="Hãy đặt mật khẩu cho tài khoản của bạn nào. Mật khẩu phải có ít nhất 8 ký tự, gồm chữ và số." style="color: rgb(196, 196, 196); font-size: 13px; margin-top: 4px; width: 100%; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-bottom: 4px; margin-right: 0; margin-left: 0; flex-wrap: wrap; flex-direction: column; white-space: pre-wrap;" />
                <ui:VisualElement name="InputCardEmail" style="margin-top: 32px; background-color: rgb(25, 25, 25); border-radius: 12px; padding: 12px; width: 100%; border-left-color: rgb(37, 37, 37); border-right-color: rgb(37, 37, 37); border-top-color: rgb(37, 37, 37); border-bottom-color: rgb(37, 37, 37); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 0; border-left-width: 1px; padding-top: 0; padding-right: 16px; padding-bottom: 0; padding-left: 16px; border-bottom-right-radius: 0; border-bottom-left-radius: 0;">
                    <ui:VisualElement name="InputEmail" style="position: relative; flex-direction: row; align-items: center;">
                        <ui:TextField name="NewPasswordField" placeholder="Email" placeholder-text="Mật khẩu" style="flex-grow: 1; color: rgb(255, 255, 255); background-color: rgba(0, 0, 0, 0); border: none; padding-right: 36px; align-content: auto; align-self: center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; -unity-background-image-tint-color: rgba(255, 255, 255, 0.72); font-size: 16px; background-size: 100% 100%; height: 54px; -unity-text-outline-color: rgba(255, 255, 255, 0);" />
                        <ui:VisualElement name="NewPasswordToggle" style="width: 24px; height: 24px; position: absolute; right: 0; top: auto; background-image: url(&quot;project://database/Assets/UI/Images/eye-slash.png?fileID=2800000&amp;guid=abe7b7c2adf1ad14fb75c5ab08aa1ea2&amp;type=3#eye-slash&quot;); -unity-background-scale-mode: scale-to-fit; -unity-text-align: middle-left; justify-content: flex-start; align-content: center;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="InputCardPassword" style="margin-top: 0; background-color: rgb(25, 25, 25); border-radius: 12px; padding: 12px; width: 100%; border-left-color: rgb(37, 37, 37); border-right-color: rgb(37, 37, 37); border-top-color: rgb(37, 37, 37); border-bottom-color: rgb(37, 37, 37); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; padding-top: 0; padding-right: 16px; padding-bottom: 0; padding-left: 16px; border-top-left-radius: 0; border-top-right-radius: 0;">
                    <ui:VisualElement name="InputPassword" style="position: relative; flex-direction: row; align-items: center;">
                        <ui:TextField name="ConfirmPasswordField" placeholder="Mật khẩu" isPassword="true" password="true" placeholder-text="Nhập lại mật khẩu" style="flex-grow: 1; color: rgb(255, 255, 255); background-color: transparent; border: none; padding-right: 36px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; -unity-text-align: upper-left; align-content: auto; align-self: center; justify-content: flex-start; font-size: 16px; height: 54px; -unity-text-outline-color: rgba(255, 255, 255, 0);" />
                        <ui:VisualElement name="ConfirmPasswordToggle" style="width: 24px; height: 24px; position: absolute; right: 0; top: auto; background-image: url(&quot;project://database/Assets/UI/Images/eye-slash.png?fileID=2800000&amp;guid=abe7b7c2adf1ad14fb75c5ab08aa1ea2&amp;type=3#eye-slash&quot;); -unity-background-scale-mode: scale-to-fit; -unity-text-align: middle-left; justify-content: flex-start; align-content: center;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="NewPassChangeButton" text="Thay đổi" style="height: 52px; width: 100%; background-color: rgb(59, 49, 137); color: rgb(243, 243, 243); border-radius: 28px; margin-bottom: 32px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; margin-top: 0; margin-right: 0; margin-left: 0; padding-top: 12px; padding-bottom: 12px; padding-right: 16px; padding-left: 16px; font-size: 16px;" />
        </ui:VisualElement>
        <ui:VisualElement name="SignupLoading" class="login-loading" style="display: none; background-color: rgba(7, 6, 7, 0.6);">
            <ui:VisualElement name="VisualElement" class="loading-card" style="align-items: center; width: 90%; margin-right: 16px; margin-left: 16px;">
                <ui:VisualElement name="LogoSucces" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/UI/Images/check-circle.png?fileID=2800000&amp;guid=98ec86bfa97264b49b3d01f806842c6f&amp;type=3#check-circle&quot;); width: 120px; height: 120px; margin-top: 18px;" />
                <ui:Label text="Đăng ký thành công!" name="LoadingTitleLabel" class="loading-text" style="-unity-font-style: bold; font-size: 20px; color: rgba(93, 76, 214, 0.92); margin-top: 46px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-right: 0; margin-left: 0; margin-bottom: 12px;" />
                <ui:Label text="Vui lòng chờ....&#10;Bạn sẽ được chuyển qua trang đăng nhập." name="LoadingMessageLabel" class="loading-text" style="-unity-font-style: normal; font-size: 16px; color: rgba(186, 186, 186, 0.92); margin-top: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-right: 0; margin-left: 0; margin-bottom: 0; -unity-text-align: upper-center; -unity-paragraph-spacing: 9px; flex-wrap: wrap; white-space: normal;" />
                <ui:VisualElement name="IconSucces" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/UI/Images/Loader.png?fileID=2800000&amp;guid=16426ad52bfd8f242ac8111c9f166511&amp;type=3#Loader&quot;); width: 68px; height: 68px; margin-top: 38px;" />
            </ui:VisualElement>
        </ui:VisualElement>
