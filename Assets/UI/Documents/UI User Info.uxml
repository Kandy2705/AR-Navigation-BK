<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/UI%20User%20Info.uss?fileID=7433441132597879392&amp;guid=6ebcc0600f4ee8a4ba705f0468ca3030&amp;type=3#UI User Info" />
    <ui:VisualElement name="screen-user-info" class="screen-container" style="background-color: rgb(25, 25, 25);">
        <ui:VisualElement name="VisualElement" class="header-row" style="margin-top: 44px;">
            <ui:VisualElement style="flex-direction: row; margin-left: 16px; align-items: center;">
                <ui:Button name="BtnBack" class="header-icon-btn back-icon" style="background-image: url(&quot;project://database/Assets/UI/Styles/Material/Icon%20Button.png?fileID=2800000&amp;guid=2565872aae8083f48ad792e6916f938f&amp;type=3#Icon Button&quot;);" />
                <ui:Label text="Thông tin cá nhân" class="header-title" style="-unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Poppins-Regular.ttf?fileID=12800000&amp;guid=f1f7c436755b83142926c04250f56572&amp;type=3#Poppins-Regular&quot;); font-size: 16px; -unity-text-align: middle-left; margin-left: 8px;" />
            </ui:VisualElement>
            <ui:Button name="btn-save" class="header-icon-btn check-icon" style="background-image: url(&quot;project://database/Assets/UI/Styles/Material/check-circle.png?fileID=2800000&amp;guid=43777c6bb54037b43befcc41ef59383a&amp;type=3#check-circle&quot;); margin-right: 12px;" />
        </ui:VisualElement>
        <ui:VisualElement class="content-scroll" style="flex-grow: 1; margin-top: 30px;">
            <ui:VisualElement class="title-section">
                <ui:Label text="Thông" class="page-big-title" style="-unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Poppins-SemiBold.ttf?fileID=12800000&amp;guid=061287b66ecca5f4d9da25a0991292c6&amp;type=3#Poppins-SemiBold&quot;);" />
                <ui:Label text="Để được tham gia thì bạn hãy hoàn thiện hồ sơ bên dưới." class="page-desc" style="-unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Poppins-Light.ttf?fileID=12800000&amp;guid=4d644c01b0cefd744a0bca86e9c81347&amp;type=3#Poppins-Light&quot;);" />
            </ui:VisualElement>
            <ui:VisualElement class="avatar-section">
                <ui:VisualElement class="avatar-wrapper">
                    <ui:VisualElement class="avatar-image" style="background-image: url(&quot;project://database/Assets/UI/Styles/Material/Avatar.png?fileID=2800000&amp;guid=0cc8e62e72b2b4d48a50a78c8117e91f&amp;type=3#Avatar&quot;);" />
                    <ui:Button class="avatar-edit-btn" style="background-image: url(&quot;project://database/Assets/UI/Styles/Material/Icon%20Button%202.png?fileID=2800000&amp;guid=6716729fc25988748b7df7fc90deeeed&amp;type=3#Icon Button 2&quot;); bottom: -13px; right: -10px;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="grouped-section" style="background-color: rgb(28, 28, 30);">
                <ui:TextField value="Kandy" name="input-name" class="custom-input" style="-unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Poppins-Regular.ttf?fileID=12800000&amp;guid=f1f7c436755b83142926c04250f56572&amp;type=3#Poppins-Regular&quot;);" />
                <ui:TextField value="04384983483" name="input-phone" class="custom-input" style="-unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Poppins-Regular.ttf?fileID=12800000&amp;guid=f1f7c436755b83142926c04250f56572&amp;type=3#Poppins-Regular&quot;);" />
                <ui:VisualElement style="flex-direction: row; justify-content: space-between; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Poppins-Regular.ttf?fileID=12800000&amp;guid=f1f7c436755b83142926c04250f56572&amp;type=3#Poppins-Regular&quot;); align-items: center;">
                    <ui:TextField value="Nữ" name="input-gender" class="custom-input" />
                    <ui:VisualElement class="arrow-down-icon" style="background-image: url(&quot;project://database/Assets/UI/Styles/Material/chevron-down.png?fileID=2800000&amp;guid=0260045e46cadd545a8d5209a05f5388&amp;type=3#chevron-down&quot;);" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: row; justify-content: space-between; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Poppins-Regular.ttf?fileID=12800000&amp;guid=f1f7c436755b83142926c04250f56572&amp;type=3#Poppins-Regular&quot;); align-items: center;">
                    <ui:TextField value="27/05/2004" name="input-birthday" class="custom-input" />
                    <ui:VisualElement class="arrow-down-icon" style="background-image: url(&quot;project://database/Assets/UI/Styles/Material/chevron-down.png?fileID=2800000&amp;guid=0260045e46cadd545a8d5209a05f5388&amp;type=3#chevron-down&quot;);" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="bottom-actions" style="margin-top: 30px; justify-content: space-evenly; align-items: center;">
            <ui:Button text="Đổi Email" name="BtnEmailChange" class="action-btn" style="-unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Poppins-Regular.ttf?fileID=12800000&amp;guid=f1f7c436755b83142926c04250f56572&amp;type=3#Poppins-Regular&quot;);" />
            <ui:Button text="Đổi mật khẩu" name="BtnPasswordChange" class="action-btn" style="align-self: auto; align-content: flex-start; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Poppins-Regular.ttf?fileID=12800000&amp;guid=f1f7c436755b83142926c04250f56572&amp;type=3#Poppins-Regular&quot;); margin-top: 20px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
