<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/UI%20Email%20Changing.uss?fileID=7433441132597879392&amp;guid=3290707c2cfd90b48a3b7de5a555010c&amp;type=3#UI Email Changing" />
    <ui:VisualElement name="screen-change-pass" class="container" style="min-height: 812px; max-height: 1000px; background-color: rgb(25, 25, 25);">
        <ui:VisualElement class="header-section">
            <ui:Button name="Btn-Back" text="←" class="btn-back" />
        </ui:VisualElement>
        <ui:ScrollView horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" touch-scroll-type="Clamped" elasticity="0" style="flex-grow: 1;">
            <ui:Label text="Thay đổi mật khẩu" class="page-big-title" style="-unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Poppins-SemiBold.ttf?fileID=12800000&amp;guid=061287b66ecca5f4d9da25a0991292c6&amp;type=3#Poppins-SemiBold&quot;);" />
            <ui:Label text="Vui lòng nhập mật khẩu cũ và mật khẩu mới của bạn và chúng tôi sẽ xác nhận lại xem có phù hợp chưa và chấp nhận thay đổi." class="page-desc" style="-unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Poppins-Regular.ttf?fileID=12800000&amp;guid=f1f7c436755b83142926c04250f56572&amp;type=3#Poppins-Regular&quot;);" />
            <ui:VisualElement class="grouped-section">
                <ui:VisualElement class="password-row">
                    <PlaceHolder placeholder-text="Mật khẩu cũ" name="OldPasswordInput" class="clean-input" style="-unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Poppins-Regular.ttf?fileID=12800000&amp;guid=f1f7c436755b83142926c04250f56572&amp;type=3#Poppins-Regular&quot;);" />
                    <ui:Button name="OldToggleEyeIcon" class="icon-eye-closed" />
                </ui:VisualElement>
                <ui:VisualElement class="password-row">
                    <PlaceHolder placeholder-text="Mật khẩu mới" name="NewPasswordInput" class="clean-input" style="-unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Poppins-Regular.ttf?fileID=12800000&amp;guid=f1f7c436755b83142926c04250f56572&amp;type=3#Poppins-Regular&quot;);" />
                    <ui:Button name="NewToggleEyeIcon" class="icon-eye-closed" />
                </ui:VisualElement>
                <ui:VisualElement class="password-row" style="border-bottom-width: 0;">
                    <PlaceHolder placeholder-text="Nhập lại mật khẩu mới" name="ConfirmNewPasswordInput" class="clean-input" style="-unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Poppins-Regular.ttf?fileID=12800000&amp;guid=f1f7c436755b83142926c04250f56572&amp;type=3#Poppins-Regular&quot;);" />
                    <ui:Button name="ConfirmToggleEyeIcon" class="icon-eye-closed" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="ErrorLabel" text="Tài khoản hoặc mật khẩu không chính xác, vui lòng nhập lại" class="error-text" style="height: 20px; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Poppins-MediumItalic.ttf?fileID=12800000&amp;guid=555fd9576a34fa946892ea4ff9365516&amp;type=3#Poppins-MediumItalic&quot;);" />
            <ui:Button name="btn-forgot-pass" text="Quên mật khẩu ?" class="link-btn" style="-unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Poppins-Regular.ttf?fileID=12800000&amp;guid=f1f7c436755b83142926c04250f56572&amp;type=3#Poppins-Regular&quot;);" />
        </ui:ScrollView>
        <ui:VisualElement class="flex-spacer" />
        <ui:Button text="Thay đổi" name="Btn-Confirm" class="btn-continue" style="-unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Poppins-Regular.ttf?fileID=12800000&amp;guid=f1f7c436755b83142926c04250f56572&amp;type=3#Poppins-Regular&quot;);" />
    </ui:VisualElement>
</ui:UXML>
