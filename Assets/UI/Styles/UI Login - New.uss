.container { width: 100%; height: 100%; flex-grow: 1; background-color: #1A1A1A; padding: 10px; display: flex; flex-direction: column; }
.header { margin-top: 30px; margin-bottom: 30px; flex-shrink: 0; }
.icon-back { color: #FFFFFF; font-size: 28px; -unity-font-style: bold; }
.title { color: #FFFFFF; font-size: 28px; -unity-font-style: bold; margin-bottom: 16px; white-space: normal; flex-shrink: 0; }
.subtitle { color: #C0C0C0; font-size: 14px; white-space: normal; line-height: 22px; margin-bottom: 40px; flex-shrink: 0; }
.input-group {border-color: #333333; border-width: 1px; border-radius: 12px; display: flex; flex-direction: column; overflow: hidden; flex-shrink: 0; }
.input-row { flex-direction: row; align-items: center; justify-content: space-between; height: 52px; padding-left: 16px; padding-right: 16px; flex-shrink: 0; }
.custom-input { flex-grow: 1; margin: 0; padding: 0; }
.custom-input > .unity-base-field__input { background-color: transparent; border-width: 0; color: #FFFFFF; font-size: 14px; padding: 0; margin: 0; }
.custom-input > .unity-base-field__input--placeholder { color: #888888; }
.divider { height: 1px; background-color: #333333; width: 100%; margin: 0; flex-shrink: 0; }
.icon-mail { color: #888888; font-size: 18px; flex-shrink: 0; }
.eye-icon { width: 24px; height: 24px; background-color: transparent; border-width: 0; background-image: url("project://database/Assets/UI/Images/eye-slash.png"); -unity-background-scale-mode: scale-to-fit; flex-shrink: 0; }
.remember-row { flex-direction: row; align-items: center; margin-top: 24px; margin-bottom: 24px; flex-shrink: 0; }
.checkbox-circle { width: 20px; height: 20px; border-radius: 8px; border-width: 2px; border-color: #403285; background-color: transparent; margin-right: 12px; flex-shrink: 0; }
.remember-text { color: #C0C0C0; font-size: 14px; }
.divider-main { height: 1px; background-color: #333333; width: 100%; margin-bottom: 24px; flex-shrink: 0; }
.forgot-password { color: #5E42A6; font-size: 14px; -unity-font-style: bold; align-self: center; flex-shrink: 0; }
.flex-spacer { flex-grow: 1; min-height: 20px; flex-shrink: 1; }
.btn-submit { flex-shrink: 0; background-color: #403285; color: #FFFFFF; font-size: 16px; -unity-font-style: bold; border-radius: 26px; height: 52px; border-width: 0; margin-bottom: 20px; transition-property: background-color; transition-duration: 0.2s; }
.btn-submit:hover { background-color: #4C3C9E; }
.btn-submit:active { background-color: #2D235C; }