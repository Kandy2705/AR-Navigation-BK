.btn-submit:hover { background-color: #4C3C9E; }
.btn-submit:active { background-color: #2D235C; } */
.container { flex-grow: 1; background-color: #1A1A1A; padding: 10px; display: flex; flex-direction: column; }
.header {
    margin-top: 30px;
    margin-bottom: 30px;
    flex-shrink: 0;
}
.btn-back { width: 40px; height: 40px; background-color: rgba(0,0,0,0); border-width: 0; color: white; font-size: 30px; padding-top: 60px; padding-bottom: 30px; margin: 0; }
.btn-continue {
    background-color: rgb(64, 50, 133);
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: bold;
    border-radius: 26px;
    height: 52px;
    border-width: 0;
    margin-bottom: 20px;
    transition-property: background-color;
    transition-duration: 0.2s;
}

.btn-continue:hover {
    background-color: rgb(76, 60, 158);
}

.btn-continue:active {
    background-color: rgb(45, 35, 92);
}