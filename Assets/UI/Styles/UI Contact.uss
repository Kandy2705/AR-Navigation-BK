/* Container chính: Màu nền đen, padding để tránh tai thỏ (safe area) */
.screen-container { width: 100%; height: 100%; background-color: rgb(18, 18, 18); padding: 40px 20px 40px 20px; display: flex; flex-direction: column; }

/* Header & Back Button */
.header-section { width: 100%; height: 50px; justify-content: center; align-items: flex-start; margin-bottom: 20px; }
.btn-back { width: 40px; height: 40px; background-color: rgba(0,0,0,0); border-width: 0; color: white; font-size: 30px; padding: 0; margin: 0; }

/* Typography */
.h1-title { font-size: 28px; color: white; -unity-font-style: bold; margin-bottom: 30px; }
.label-title { font-size: 14px; color: rgb(170, 170, 170); margin-bottom: 4px; }
.label-value { font-size: 16px; color: white; white-space: normal; }

/* Các dòng thông tin (Row) */
.info-row { flex-direction: row; align-items: center; padding-top: 15px; padding-bottom: 15px; width: 100%; }
.text-group { flex-direction: column; justify-content: center; flex-shrink: 1; margin-right: 10px; }

/* Icon tròn màu tím */
.icon-container { width: 44px; height: 44px; background-color: rgb(45, 40, 60); border-radius: 22px; margin-right: 15px; justify-content: center; align-items: center; flex-shrink: 0; }
.icon-img { width: 24px; height: 24px; -unity-background-scale-mode: scale-to-fit; } 

/* Đường kẻ ngăn cách */
.separator { height: 1px; width: 100%; background-color: rgb(50, 50, 50); margin-left: 60px; }

/* Nút chính (Primary Button) */
.btn-primary { width: 100%; height: 55px; background-color: rgb(72, 60, 155); border-radius: 28px; border-width: 0; color: white; font-size: 18px; -unity-font-style: bold; margin-top: 20px; transition-duration: 0.2s; }
.btn-primary:active { background-color: rgb(100, 80, 200); scale: 0.98; }

/* Placeholder cho icon (Thay URL bằng icon thật của bạn) */
/* Bạn có thể tải icon Address, Phone, Email về và gán vào đây trong UI Builder hoặc Code */
.icon-address { background-color: rgb(130, 100, 255); /* Tạm thời để màu tím sáng thay cho hình */ }
.icon-phone { background-color: rgb(130, 100, 255); }
.icon-email { background-color: rgb(130, 100, 255); }