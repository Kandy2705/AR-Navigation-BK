/* Layout chính */
.screen-container { flex-grow: 1; background-color: #121212; color: white; font-size: 14px; }
.content-scroll { flex-grow: 1; padding: 10px 20px; }

/* Header */
.header-row { flex-direction: row; align-items: center; justify-content: space-between; height: 60px; padding: 10px 20px; margin-bottom: 0; }
.header-title { font-size: 18px; -unity-font-style: bold; color: white; }
.header-icon-btn { width: 32px; height: 32px; background-color: transparent; border-width: 0; }
.back-icon { background-image: url("project://database/Assets/UI/Icons/arrow-left-white.png"); -unity-background-image-tint-color: white; -unity-background-scale-mode: scale-to-fit; }

/* Filter Chips (Horizontal Scroll) */
.chip-scroll-container { height: 60px; margin-bottom: 10px; padding-left: 20px; flex-shrink: 0; }
.chip-row { flex-direction: row; align-items: center; height: 100%; padding-right: 20px; }
.chip-btn { white-space: nowrap; flex-shrink: 0; height: 36px; padding: 0 20px; border-radius: 18px; margin-right: 12px; background-color: #1C1C1E; border-width: 1px; border-color: #2C2C2E; color: #EBEBF5; -unity-font-style: normal; font-size: 14px; -unity-text-align: middle-center; }
/* Chip đang chọn (Màu tím) */
.chip-active { background-color: #5E5CE6; border-width: 0; color: white; -unity-font-style: bold; }

/* FAQ Item Container */
.faq-item { background-color: #1C1C1E; border-radius: 12px; margin-bottom: 16px; overflow: hidden; border-width: 1px; border-color: transparent; transition: background-color 0.2s; }
.faq-item:hover { border-color: #2C2C2E; }

/* Header của câu hỏi (Phần luôn hiện) */
.faq-header { flex-direction: row; justify-content: space-between; align-items: center; padding: 16px; min-height: 56px; }
.faq-question { font-size: 15px; -unity-font-style: bold; color: white; white-space: normal; flex-grow: 1; margin-right: 10px; }

/* Icon mũi tên */
.arrow-icon { width: 16px; height: 16px; -unity-background-scale-mode: scale-to-fit; opacity: 0.7; }
.arrow-right { background-image: url("project://database/Assets/UI/Icons/chevron-right.png"); -unity-background-image-tint-color: white; }
.arrow-up { background-image: url("project://database/Assets/UI/Icons/chevron-up.png"); -unity-background-image-tint-color: white; }

/* Phần câu trả lời (Mặc định ẩn) */
.faq-answer { display: none; padding: 0 16px 20px 16px; font-size: 14px; color: #A0A0A0; white-space: normal; line-height: 20px; }

/* Trạng thái MỞ (Được add class này khi click) */
.faq-item--open .faq-answer { display: flex; }
.faq-item--open { background-color: #252527; }