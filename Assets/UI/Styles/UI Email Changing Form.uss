.container {
    flex-grow: 1;
    background-color: rgb(26, 26, 26);
    padding: 10px;
    display: flex;
    flex-direction: column;
}

.header {
    margin-top: 30px;
    margin-bottom: 30px;
    flex-shrink: 0;
}

.icon-back {
    color: rgb(255, 255, 255);
    font-size: 28px;
    -unity-font-style: bold;
}

.title {
    color: rgb(255, 255, 255);
    font-size: 28px;
    -unity-font-style: bold;
    margin-bottom: 16px;
    white-space: normal;
}

.btn-back { width: 40px; height: 40px; background-color: rgba(0,0,0,0); border-width: 0; color: white; font-size: 30px; padding-top: 60px; padding-bottom: 30px; margin: 0; }

.subtitle {
    color: rgb(192, 192, 192);
    font-size: 14px;
    white-space: normal;
    line-height: 22px;
    margin-bottom: 40px;
}

.input-group {
    flex-direction: row;
    /* background-color: rgb(34, 34, 34); */
    border-color: rgb(51, 51, 51);
    border-width: 1px;
    border-radius: 12px;
    height: 52px;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
}

.email-input {
    flex-grow: 1;
    background-color: transparent;
    border-width: 0;
    color: rgb(136, 136, 136);
    font-size: 14px;
}

.email-input > .unity-base-field__input {
    background-color: transparent;
    border-width: 0;
    color: rgb(136, 136, 136);
    padding: 0;
    margin: 0;
}

.icon-mail {
    color: rgb(136, 136, 136);
    font-size: 10px;
}

.flex-spacer {
    flex-grow: 1;
}

.btn-continue {
    background-color: rgb(64, 50, 133);
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: bold;
    border-radius: 26px;
    height: 52px;
    border-width: 0;
    margin-bottom: 20px;
    transition-property: background-color;
    transition-duration: 0.2s;
}

.btn-continue:hover {
    background-color: rgb(76, 60, 158);
}

.btn-continue:active {
    background-color: rgb(45, 35, 92);
}
